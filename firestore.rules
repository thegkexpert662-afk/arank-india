rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsApp(appId) { return signedIn() && get(/databases/$(database)/documents/apps/$(appId)).data.ownerAdminUid == request.auth.uid; }
    function isMaster() {
      return signedIn() && get(/databases/$(database)/documents/master_admins/$(request.auth.uid)).data.role == 'master_admin' && get(/databases/$(database)/documents/master_admins/$(request.auth.uid)).data.isActive == true;
    }
    function studentInstitute() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('instituteId', get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tenantId', ''));
    }
    function videoStudentAllowed(instituteId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        && get(/databases/$(database)/documents/apps/$(instituteId)).data.isActive == true
        && get(/databases/$(database)/documents/service_controls/global).data.get('videoSolutions', true) == true
        && get(/databases/$(database)/documents/apps/$(instituteId)).data.ownerAdminUid != ''
        && get(/databases/$(database)/documents/admin_service_controls/$(get(/databases/$(database)/documents/apps/$(instituteId)).data.ownerAdminUid)).data.get('videoSolutions', false) == true
        && studentInstitute() == instituteId;
    }

    match /master_admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow create, update, delete: if false; }
    match /service_controls/{docId} { allow read: if signedIn(); allow create, update, delete: if isMaster(); }
    match /admin_service_controls/{adminUid} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == adminUid);
      allow create, update, delete: if isMaster();
    }

    match /video_solutions/{videoId} {
      allow read: if isMaster() || videoStudentAllowed(resource.data.get('instituteId', '')) || (signedIn() && ownsApp(resource.data.get('instituteId', '')) && get(/databases/$(database)/documents/service_controls/global).data.get('videoSolutions', true) == true && get(/databases/$(database)/documents/admin_service_controls/$(request.auth.uid)).data.get('videoSolutions', false) == true);
      allow create: if isMaster() || (signedIn() && request.resource.data.get('instituteId', '') != '' && ownsApp(request.resource.data.instituteId) && get(/databases/$(database)/documents/apps/$(request.resource.data.instituteId)).data.isActive == true && get(/databases/$(database)/documents/service_controls/global).data.get('videoSolutions', true) == true && get(/databases/$(database)/documents/admin_service_controls/$(request.auth.uid)).data.get('videoSolutions', false) == true);
      allow update: if isMaster() || (signedIn() && ownsApp(resource.data.get('instituteId', '')) && request.resource.data.get('instituteId', '') == resource.data.get('instituteId', '') && get(/databases/$(database)/documents/service_controls/global).data.get('videoSolutions', true) == true && get(/databases/$(database)/documents/admin_service_controls/$(request.auth.uid)).data.get('videoSolutions', false) == true);
      allow delete: if isMaster() || (signedIn() && ownsApp(resource.data.get('instituteId', '')) && get(/databases/$(database)/documents/service_controls/global).data.get('videoSolutions', true) == true && get(/databases/$(database)/documents/admin_service_controls/$(request.auth.uid)).data.get('videoSolutions', false) == true);
    }

    match /apps/{appId} {
      allow read: if resource.data.isActive == true || isMaster() || ownsApp(appId);
      allow create: if (signedIn() && request.resource.data.ownerAdminUid == request.auth.uid) || isMaster();
      allow update, delete: if isMaster() || (ownsApp(appId) && request.resource.data.ownerAdminUid == resource.data.ownerAdminUid);
    }
    match /admins/{adminUid} { allow read: if isMaster() || (signedIn() && request.auth.uid == adminUid); allow create, update: if isMaster() || (signedIn() && request.auth.uid == adminUid); allow delete: if isMaster(); }
    match /admin_contacts/{adminUid} { allow read, write: if isMaster() || (signedIn() && request.auth.uid == adminUid); }
    match /users/{uid} {
      allow create: if isMaster() || (signedIn() && request.auth.uid == uid && request.resource.data.get('tenantId', '') != '' && get(/databases/$(database)/documents/apps/$(request.resource.data.tenantId)).data.isActive == true);
      allow read: if isMaster() || (signedIn() && (request.auth.uid == uid || ownsApp(resource.data.get('tenantId', ''))));
      allow update: if isMaster() || (signedIn() && request.auth.uid == uid && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isMaster() || (signedIn() && request.auth.uid == uid);
      match /achievements/{achievementId} { allow read, write: if isMaster() || (signedIn() && request.auth.uid == uid); }
    }
    match /audit_logs/{logId} { allow read, create: if isMaster(); allow update, delete: if false; }
    match /{collection}/{docId} {
      allow read: if isMaster() || (signedIn() && ((resource.data.get('tenantId', '') != '' && ownsApp(resource.data.tenantId)) || (resource.data.get('tenantId', '') != '' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tenantId', '') == resource.data.tenantId && resource.data.get('isActive', true) == true)));
      allow create: if isMaster() || (signedIn() && request.resource.data.get('tenantId', '') != '' && ownsApp(request.resource.data.tenantId));
      allow update: if isMaster() || (signedIn() && ownsApp(resource.data.get('tenantId', '')) && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isMaster() || (signedIn() && ownsApp(resource.data.get('tenantId', '')));
    }
  }
}
